---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import ContactDetails from '../components/sections/ContactDetails.astro';
import CoveredAreas from '../components/sections/CoveredAreas/CoveredAreas.astro';
import { getBusiness, getSite } from '../data/loaders';

const business = getBusiness();
const site = getSite();
---

<BaseLayout
  title={`Contact Us${site.seo.title_separator}${business.name}`}
  description={`Contact ${business.name} for a free estimate. Serving ${business.service_area}.`}
  path="/contact-us"
  pageType="contact"
>
  <PageHeader
    title="Contact Us"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]}
    size="standard"
  />

  <ContactDetails />

  {site.features.enable_areas && <CoveredAreas />}
</BaseLayout>
