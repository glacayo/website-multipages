---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import AboutStory from '../components/sections/AboutStory.astro';
import MissionVision from '../components/sections/MissionVision.astro';
import About from '../components/sections/About.astro';
import CTABar from '../components/sections/CTABar.astro';
import { getBusiness, getSite } from '../data/loaders';

const business = getBusiness();
const site = getSite();
---

<BaseLayout
  title={`About Us${site.seo.title_separator}${business.name}`}
  description={`Learn more about ${business.name}, serving ${business.service_area}.`}
  path="/about-us"
  pageType="about"
>
  <PageHeader
    title="About Us"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
    size="standard"
  />

  <AboutStory />
  <MissionVision />
  <About />
  <CTABar />
</BaseLayout>
